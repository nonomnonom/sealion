# Sealion uses Mastra's model router. Pick whichever provider(s) you want
# to run — only the ones you actually use need to be set.
#
# Format in code: `model: "provider/model-name"`. See full list at
# https://mastra.ai/models
#
# OpenAI:
OPENAI_API_KEY=sk-...

# Anthropic:
ANTHROPIC_API_KEY=sk-ant-...

# Google AI Studio (Gemini):
GOOGLE_GENERATIVE_AI_API_KEY=...

# Groq:
GROQ_API_KEY=gsk_...

# DeepSeek:
DEEPSEEK_API_KEY=...

# xAI (Grok):
XAI_API_KEY=...

# Mistral:
MISTRAL_API_KEY=...

# Together AI:
TOGETHER_AI_API_KEY=...

# OpenRouter (gateway to 100+ models):
OPENROUTER_API_KEY=sk-or-...

# For Ollama / local models, no API key needed — just set the model string:
#   model: "ollama/llama3.1"
